---
import Base from '../layouts/Base.astro';
import {site} from '../data/content.js';
import SocialLinks from '../components/SocialLinks.astro';
import {deServices,deCoaching,deSpiritual,deTopics,deSiteDescription} from '../data/de.js';
import SocialLinks from './SocialLinks.astro';
const {kind='home',service=null}=Astro.props;
const wa=(context)=>'https://wa.me/'+site.phone+'?text='+encodeURIComponent('Guten Tag Frau Alkaya, ich interessiere mich für '+context+'. Können Sie mir weitere Informationen geben?');
const titles={home:'Coaching und spirituelle Begleitung',about:'Über mich',services:'Angebote im Überblick',insights:'Gedanken & Einblicke',contact:'Kontakt & Gespräch'};
const desc={
 home:deSiteDescription,
 about:'Lernen Sie Neşe Alkayas Haltung zum persönlichen Coaching und ihre Verbindung zur alevitischen Tradition kennen.',
 services:'Persönliches Coaching, Orientierungsgespräche und eigenständige spirituelle Angebote. Finden Sie ein Gespräch, das zu Ihrem Anliegen passt.',
 insights:'Gedanken über Entscheidungen, Beziehungen und innere Klarheit – und die offiziellen Social-Media-Kanäle von Neşe Alkaya.',
 contact:'Nehmen Sie Kontakt zu Neşe Alkaya auf. Fragen zu Gesprächsablauf, Verfügbarkeit und Konditionen klären Sie direkt per WhatsApp oder E-Mail.'
};
const title=service?.title||titles[kind];
const faqItems=kind==='services'?[{"q":"Wie kann ich ein Gespräch anfragen?","a":"Wählen Sie ein passendes Angebot und schreiben Sie per WhatsApp oder E-Mail. Dauer, Ablauf und Konditionen werden vor dem Termin gemeinsam geklärt."},{"q":"Sind Coaching und spirituelle Begleitung dasselbe?","a":"Nein. Persönliches Coaching und traditionelle oder symbolische Deutungsangebote sind klar voneinander getrennte Angebote."},{"q":"Ersetzen die Gespräche eine Therapie?","a":"Nein. Es werden weder medizinische Diagnosen noch psychotherapeutische Behandlungen angeboten. Bei gesundheitlichen Fragen wenden Sie sich bitte an qualifizierte Fachpersonen."}]:[];
const description=service?.short||desc[kind];
const isCoaching=service&&deCoaching.some(s=>s.slug===service.slug);
const serviceLabel=isCoaching?'Persönliches Coaching':'Spirituelle Begleitung';
const bc=service?[{name:'Startseite',href:'/de/'},{name:'Angebote',href:'/de/angebote/'},{name:service.title,href:'/de/angebote/'+service.slug+'/'}]:[];
---
<Base faqItems={faqItems} title={title} description={description} lang="de" service={service} crumbs={bc}>
{kind==='home'&&<Fragment>
<section class="home-hero"><div class="shell hero-composition">
  <div class="hero-statement"><span class="overline overline-light">Achtsamkeit <i></i> Begleitung <i></i> Wandel</span><h1>Dem eigenen Weg<br/>näherkommen.</h1><p>Manchmal brauchen wir keinen neuen Weg, sondern einen klareren Blick auf den eigenen.</p><div class="hero-cta"><a class="button button-gold" href={wa('einem persönlichen Gespräch')} target="_blank" rel="noopener noreferrer">Gespräch anfragen ↗</a><a href="/de/ueber-mich/" class="text-link text-link-light">Mehr erfahren ↗</a></div></div>
  <div class="hero-image-and-intro"><div class="portrait-frame"><img src="/nese-alkaya-portrait-2x.webp" alt="Porträt von Neşe Alkaya" width="1474" height="3072" loading="eager" fetchpriority="high" decoding="async"/></div></div>
  <div class="hero-photo-caption"><span class="overline">Persönliche Wegbegleitung</span><h2>Die eigenen Antworten finden.</h2><p>Gespräche für Orientierung, persönliche Entwicklung und einen bewussten Blick nach innen.</p></div>
</div></section>
<section class="section-space"><div class="shell introduction"><div class="statement-card"><span class="overline">Ein Moment zum Innehalten</span><blockquote>„Manchmal eröffnet ein Gespräch eine neue Sichtweise.“</blockquote><span class="statement-sign">Mit Ruhe und Aufmerksamkeit.</span></div><div class="intro-body"><span class="overline">Mein Ansatz</span><h2 class="display-title">Jeder Weg hat sein eigenes Tempo.</h2><p>Die Begleitung mit Neşe Alkaya lädt dazu ein, in unterschiedlichen Lebensphasen innezuhalten und neue Klarheit und Ruhe zu finden.</p><p>Dabei geht es darum, die eigenen Fragen zu vertiefen und den eigenen Antworten wieder näherzukommen – ohne fertige Lösungen vorzugeben.</p><a href="/de/ueber-mich/" class="text-link">Mehr über meinen Ansatz ↗</a></div></div></section>
<section class="section-space section-warm"><div class="shell"><div class="section-heading"><div><span class="overline">Persönliche Gespräche</span><h2 class="display-title">Raum für neue Perspektiven.</h2></div><p>Die eigenen Prioritäten erkennen, Entscheidungen überdenken und Veränderungen bewusst gestalten.</p></div><div class="editorial-cards">{deCoaching.slice(0,3).map(s=><a class="editorial-card" href={'/de/angebote/'+s.slug+'/'}><span class="card-category">Coaching ↗</span><h3>{s.title}</h3><p>{s.short}</p><span class="card-action">Angebot ansehen ↗</span></a>)}</div><div class="below-grid-link"><a href="/de/angebote/" class="text-link">Alle Coaching-Angebote ↗</a></div></div></section>
<section class="section-space section-forest"><div class="shell"><div class="section-heading"><div><span class="overline overline-light">Spirituelle Begleitung</span><h2 class="display-title">Tradition und innere Wahrnehmung.</h2></div><p>Überlieferte Deutungen und persönliche Fragen in einem respektvollen spirituellen Rahmen.</p></div><div class="spiritual-grid">{deSpiritual.slice(0,3).map(s=><a class="spiritual-card" href={'/de/angebote/'+s.slug+'/'}><span class="card-category">Spirituelles Gespräch</span><h3>{s.title}</h3><span class="card-action">Mehr erfahren ↗</span></a>)}</div><div class="below-grid-link"><a href="/de/angebote/" class="text-link text-link-light">Alle spirituellen Angebote ↗</a></div><p class="fineprint">Spirituelle Deutungen sind keine medizinische Diagnostik und enthalten keine sicheren Zukunftsprognosen.</p></div></section>
<section class="section-space"><div class="shell about-feature"><div class="about-feature-copy"><span class="overline">Hintergrund und Haltung</span><h2 class="display-title">Erfahrung, Respekt und Tradition.</h2><p>Persönliches Coaching und die alevitische Tradition gehören zu unterschiedlichen Bereichen ihres Wirkens. Was beide verbindet, ist eine Haltung der Wertschätzung.</p><a class="text-link" href="/de/ueber-mich/">Die Geschichte kennenlernen ↗</a></div><div class="quote-feature"><span class="overline">Was mir wichtig ist</span><blockquote>„Jeder Mensch verdient es, gehört und mit Respekt behandelt zu werden.“</blockquote></div></div></section>
<section class="section-space section-warm"><div class="shell"><div class="section-heading"><div><span class="overline">Aus dem Leben</span><h2 class="display-title">Themen, die uns bewegen.</h2></div><p>Gedanken zu Beziehungen, Veränderungen und dem eigenen Weg.</p></div><div class="topic-columns">{deTopics.map(t=><article><span class="topic-rule" aria-hidden="true"></span><h3>{t.title}</h3><p>{t.text}</p></article>)}</div><a href="/de/einblicke/" class="text-link">Weitere Einblicke ↗</a></div></section>
<section class="section-space section-final"><div class="shell"><div class="final-banner"><div><span class="overline overline-light">Ein erster Schritt</span><h2 class="display-title">Lassen Sie uns ins Gespräch kommen.</h2><p>Fragen zu Ablauf und verfügbaren Terminen können wir persönlich klären.</p></div><a href={wa('einem Gespräch')} target="_blank" rel="noopener noreferrer" class="button button-gold">Per WhatsApp anfragen ↗</a></div></div></section>
</Fragment>}
{kind==='about'&&<Fragment>
<section class="about-lead-section"><div class="shell about-lead-grid">
<div class="about-lead-copy"><span class="overline">Über mich</span><h1>Menschen auf ihrem eigenen Weg begleiten.</h1><p class="about-lead-intro">Zeit zum Zuhören, zum Sortieren und für einen neuen Blick auf das, was gerade wichtig ist.</p><div class="about-lead-story"><span class="overline">Meine Haltung</span><h2>Erst zuhören. Dann gemeinsam klarer sehen.</h2><p>In verschiedenen Lebensphasen kann ein vertrauensvolles Gespräch dabei helfen, die eigenen Gedanken zu ordnen und wieder ein Gefühl für die persönliche Richtung zu entwickeln.</p><p>Meine Begleitung ist eine Einladung, Fragen zu vertiefen und sich den eigenen Antworten in Ruhe zu nähern. Die Entscheidungen bleiben bei Ihnen.</p><a href="/de/angebote/" class="text-link">Gesprächsangebote entdecken ↗</a></div></div>
<figure class="about-lead-image"><img src="/nese-alkaya-portrait-2x.webp" alt="Neşe Alkaya – persönliches Porträt" width="1474" height="3072" loading="eager" decoding="async"/></figure>
</div></section>
<section class="section section-warm"><div class="shell editorial-text-grid"><div><span class="overline">Beruflicher Hintergrund</span><h2 class="section-title">Kommunikation und Aufmerksamkeit.</h2></div><div class="prose"><p>In ihrer Arbeit greift Neşe Alkaya auf Methoden aus dem Bereich NLP (Neuro-Linguistisches Programmieren) und der Gesprächsführung zurück. Zu ihrem fachlichen Hintergrund gehört die Ausbildung <strong>INLPTA – Certified Practitioner</strong>.</p><p>Wichtig sind ihr respektvolle Fragen, klare Grenzen und ein Gespräch, in dem Menschen ihren eigenen Gedanken Raum geben können.</p></div></div></section>
<section class="section"><div class="shell editorial-text-grid"><div><span class="overline">Spiritueller Hintergrund</span><h2 class="section-title">Verwurzelt in der alevitischen Tradition.</h2></div><div class="prose"><p>Neşe Alkaya beschreibt ihren spirituellen Weg als Teil der alevitischen Tradition. Sie hat in einer traditionellen Ocak-Linie Unterweisung erhalten und übernimmt dort die Rolle einer <strong>Ana</strong>.</p><p>Diese spirituelle Verantwortung ist ein eigener Bereich ihres Wirkens und wird von den Coaching-Gesprächen klar unterschieden. Im Mittelpunkt stehen Achtung, Gleichwertigkeit und ein offener Umgang miteinander.</p></div></div></section>
<section class="section section-warm"><div class="shell editorial-text-grid"><div><span class="overline">Rahmen der Gespräche</span><h2 class="section-title">Offen, respektvoll und ohne Druck.</h2></div><div class="prose"><p>Ob persönliche Fragen oder ein spirituelles Anliegen: Inhalt und Rahmen werden vor einem Termin gemeinsam besprochen.</p><p class="fineprint-on-light">Die Gespräche sind weder Psychotherapie noch medizinische, rechtliche oder finanzielle Beratung. Bei entsprechenden Fragen wenden Sie sich bitte an qualifizierte Fachpersonen.</p><a href="/de/kontakt/" class="button button-gold">Kontakt aufnehmen ↗</a></div></div></section>
</Fragment>}
{kind==='services'&&<Fragment>
<section class="inner-hero"><div class="shell"><span class="overline">Angebote</span><div class="inner-hero-grid"><h1>Jeder Weg ist einzigartig.</h1><p>Ob Sie Orientierung suchen oder sich für spirituelle Traditionen interessieren: Hier finden Sie zwei eigenständige Gesprächsbereiche.</p></div></div></section>
<section class="section-space section-warm"><div class="shell"><div class="section-heading"><div><span class="overline">Persönliche Begleitung</span><h2 class="display-title">Coaching & Orientierung</h2></div><p>In einem respektvollen Gespräch stehen Ihre Fragen und Prioritäten im Mittelpunkt.</p></div><div class="service-catalog">{deCoaching.map(s=><a class="service-catalog-item" href={'/de/angebote/'+s.slug+'/'}><div><span class="card-category">Persönliches Gespräch</span><h3>{s.title}</h3><p>{s.short}</p></div><span class="service-catalog-arrow" aria-hidden="true">↗</span></a>)}</div></div></section>
<section class="section-space section-forest"><div class="shell"><div class="section-heading"><div><span class="overline overline-light">Tradition und innere Fragen</span><h2 class="display-title">Spirituelle Angebote</h2></div><p>Traditionelle, symbolische Deutungen in einem klar beschriebenen Rahmen.</p></div><div class="service-catalog service-catalog-dark">{deSpiritual.map(s=><a class="service-catalog-item" href={'/de/angebote/'+s.slug+'/'}><div><span class="card-category">Spirituelles Gespräch</span><h3>{s.title}</h3><p>{s.short}</p></div><span class="service-catalog-arrow" aria-hidden="true">↗</span></a>)}</div><p class="fineprint">Diese Angebote sind keine wissenschaftliche Diagnostik, Heilbehandlung oder sichere Zukunftsvorhersage.</p></div></section>
<section class="faq-block"><div class="shell"><span class="overline">Gut zu wissen</span><h2>Häufige Fragen</h2><div class="faq-list">{faqItems.map(item=><details><summary>{item.q}</summary><p>{item.a}</p></details>)}</div></div></section>
<section class="section-space"><div class="shell"><p class="disclaimer">Coaching und spirituelle Begleitung sind eigenständige Angebote. Umfang, Verfügbarkeit und Konditionen werden vorab persönlich geklärt. Kein Angebot ersetzt medizinische, psychotherapeutische, rechtliche oder finanzielle Beratung.</p><div class="final-banner"><div><span class="overline overline-light">Fragen zum Ablauf?</span><h2 class="display-title">Sprechen wir darüber.</h2><p>Ich informiere Sie gerne über den möglichen Rahmen eines Gesprächs.</p></div><a href="/de/kontakt/" class="button button-gold">Kontakt aufnehmen ↗</a></div></div></section>
</Fragment>}
{kind==='insights'&&<Fragment>
<section class="page-hero"><div class="shell"><span class="overline">Einblicke</span><h1>Gedanken aus dem Leben.</h1><p class="lead">Fragen zu Beziehungen, Entscheidungen, Achtsamkeit und spirituellen Traditionen.</p></div></section>
<section class="section section-warm"><div class="shell"><div class="section-heading"><div><span class="overline">Themen</span><h2 class="display-title">Einladung zum Nachdenken.</h2></div><p>Manche Fragen beschäftigen uns immer wieder – in unterschiedlichen Lebensphasen.</p></div><div class="topic-columns">{deTopics.map(t=><article><span class="topic-rule" aria-hidden="true"></span><h3>{t.title}</h3><p>{t.text}</p></article>)}</div></div></section>
<section class="section"><div class="shell editorial-text-grid"><div><span class="overline">Soziale Medien</span><h2 class="section-title">Videos und neue Gedanken.</h2></div><div class="prose"><p>Aktuelle Beiträge finden Sie direkt auf den offiziellen Kanälen bei Instagram, TikTok und YouTube. Viele Beiträge werden auf Türkisch veröffentlicht.</p><SocialLinks label={'Soziale Medien'}/></div></div></section>
</Fragment>}
{kind==='contact'&&<Fragment>
<section class="page-hero"><div class="shell"><span class="overline">Kontakt</span><h1>Der erste Schritt ist ein Gespräch.</h1><p class="lead">Erzählen Sie mir, was Sie beschäftigt. Verfügbarkeit, Dauer und Ablauf klären wir gemeinsam.</p></div></section>
<section class="section section-warm"><div class="shell contact-page-grid"><div class="contact-page-primary"><span class="overline">Direkter Kontakt</span><h2>Ich freue mich auf Ihre Nachricht.</h2><p>Schreiben Sie mir über WhatsApp, wenn Sie Fragen zu einem Angebot oder zu einem möglichen Termin haben.</p><a href={wa('einem Termin')} target="_blank" rel="noopener noreferrer" class="button button-gold">WhatsApp öffnen ↗</a></div><div class="contact-page-secondary"><span class="overline">Kontaktmöglichkeiten</span><a href={'tel:+'+site.phone}>{site.phoneDisplay}</a><a href={'mailto:'+site.email}>{site.email}</a><SocialLinks label={'Soziale Medien'}/></div></div></section>
</Fragment>}
{kind==='detail'&&service&&<Fragment>
<section class="detail-hero"><div class="shell detail-content-wrap"><a href="/de/angebote/" class="backlink">← Alle Angebote</a><span class="overline">{serviceLabel}</span><h1>{service.title}</h1><p class="detail-summary">{service.short}</p><a class="button button-gold" href={wa(service.title)} target="_blank" rel="noopener noreferrer">Informationen anfragen ↗</a></div></section>
<section class="detail-body-section"><div class="shell detail-content-wrap"><div class="detail-article"><div class="detail-article-label"><span class="overline">Zum Gespräch</span><h2>Was wir besprechen können</h2></div><div class="detail-article-copy"><p>{service.description}</p><p>Ablauf, Dauer und Konditionen vereinbaren wir vorab im persönlichen Kontakt.</p></div></div><div class="detail-topics-row" aria-label="Gesprächsthemen">{service.topics.map(t=><span>{t}</span>)}</div></div></section>
<div class="detail-disclaimer-section"><div class="shell detail-content-wrap"><p>Die Angebote ersetzen keine medizinische, psychotherapeutische, rechtliche oder finanzielle Beratung. Spirituelle Deutungen enthalten keine garantierten Aussagen über die Zukunft.</p></div></div>
</Fragment>}
</Base>