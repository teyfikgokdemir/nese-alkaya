---
import {site} from '../data/content.js';
const {label='Sosyal medya hesapları'}=Astro.props;
---
<div class="social-icons" role="group" aria-label={label}>
{site.socials.map(s=><a href={s.href} class={'social-icon social-'+s.label.toLowerCase()} target="_blank" rel="noopener noreferrer" aria-label={s.label+' hesabını yeni sekmede aç'} title={s.label}>
{ s.label==='Instagram'?
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="2.4" y="2.4" width="19.2" height="19.2" rx="5.8" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4.3" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.8" cy="6.4" r="1.25" fill="currentColor"/></svg>
:s.label==='TikTok'?
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M16.66 2c.3 2.51 1.62 4.05 4.34 4.22v3.36a9.25 9.25 0 0 1-4.28-1.15v7.1c0 3.94-2.8 6.47-6.55 6.47-3.43 0-6.17-2.65-6.17-6.06 0-3.78 2.94-6.43 6.7-6.15v3.5c-1.72-.44-3.44.65-3.44 2.57 0 1.5 1.14 2.63 2.61 2.63 1.66 0 2.79-1.17 2.79-3.02V2h4z"/></svg>
:<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M22 7.45a2.75 2.75 0 0 0-1.92-1.94C18.38 5.05 12 5.05 12 5.05s-6.38 0-8.08.46A2.75 2.75 0 0 0 2 7.45 28.73 28.73 0 0 0 1.55 12c0 1.53.15 3.06.45 4.55a2.75 2.75 0 0 0 1.92 1.94c1.7.46 8.08.46 8.08.46s6.38 0 8.08-.46A2.75 2.75 0 0 0 22 16.55c.3-1.49.45-3.02.45-4.55 0-1.53-.15-3.06-.45-4.55ZM10 15.6V8.4l6.3 3.6-6.3 3.6Z"/></svg>}
</a>)}
</div>