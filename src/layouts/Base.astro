---
import {site} from '../data/content.js';
import {dePathMap,trPathMap,deSiteDescription,deServices} from '../data/de.js';
import '../styles/global.css';
import SocialLinks from '../components/SocialLinks.astro';
const {title=site.name,description=site.description,path=Astro.url.pathname,crumbs=[],lang='tr',service=null,faqItems=[],article=null}=Astro.props;
const isDe=lang==='de';
const canonical=new URL(path,site.url).href;
const localPath=isDe?(trPathMap[path]||'/'):(dePathMap[path]||'/de/');
const alternate=new URL(localPath,site.url).href;
const urlTR=isDe?alternate:canonical;
const urlDE=isDe?canonical:alternate;
const wa='https://wa.me/'+site.phone+'?text='+encodeURIComponent(isDe?'Guten Tag Frau Alkaya, ich möchte mich über ein Gespräch informieren.':'Merhaba Neşe Hanım, web siteniz üzerinden görüşme hakkında bilgi almak istiyorum.');
const nav=isDe?[
 {title:'Startseite',href:'/de/'},{title:'Über mich',href:'/de/ueber-mich/'},{title:'Angebote',href:'/de/angebote/'},{title:'Einblicke',href:'/de/einblicke/'},{title:'Blog',href:'/de/blog/'},{title:'Kontakt',href:'/de/kontakt/'}
]:[
 {title:'Ana Sayfa',href:'/'},{title:'Hakkımda',href:'/hakkimda/'},{title:'Hizmetler',href:'/hizmetler/'},{title:'İçerikler',href:'/icerikler/'},{title:'Blog',href:'/blog/'},{title:'İletişim',href:'/iletisim/'}
];
const displayTitle=title===site.name?site.name:title+' | '+site.name;
const personId=site.url+'/#person';
const websiteId=site.url+'/#website';
const graph=[
 {'@type':'Person','@id':personId,name:site.name,url:site.url,description:site.description,image:new URL('/nese-alkaya-portrait-2x.webp',site.url).href,sameAs:site.socials.map(s=>s.href),knowsAbout:['Persönliches Coaching','Yaşam koçluğu','Manevi rehberlik','Spirituelle Begleitung']},
 {'@type':'WebSite','@id':websiteId,url:site.url,name:site.name,inLanguage:['tr-TR','de-DE'],publisher:{'@id':personId}},
 {'@type':'WebPage','@id':canonical+'#webpage',url:canonical,name:title,description,inLanguage:isDe?'de-DE':'tr-TR',isPartOf:{'@id':websiteId},about:{'@id':personId},primaryImageOfPage:{'@type':'ImageObject',url:new URL('/nese-alkaya-portrait-2x.webp',site.url).href},...(crumbs.length?{breadcrumb:{'@type':'BreadcrumbList',itemListElement:crumbs.map((c,i)=>({'@type':'ListItem',position:i+1,name:c.name,item:new URL(c.href,site.url).href}))}}:{})},
 ...(service?[{'@type':'Service',name:service.title,description:service.short,provider:{'@id':personId},url:canonical,serviceType:isDe?'Persönliches Gespräch':'Bireysel görüşme'}]:[]),
 ...(faqItems.length?[{'@type':'FAQPage',mainEntity:faqItems.map(item=>({'@type':'Question',name:item.q,acceptedAnswer:{'@type':'Answer',text:item.a}}))}]:[]),
 ...(crumbs.length?[{'@type':'BreadcrumbList','@id':canonical+'#breadcrumb',itemListElement:crumbs.map((c,i)=>({'@type':'ListItem',position:i+1,name:c.name,item:new URL(c.href,site.url).href}))}]:[]),
 ...(!article && ['/blog/','/de/blog/'].includes(path)?[{'@type':'Blog','@id':canonical+'#blog',name:isDe?'Neşe Alkaya – Blog & Gedanken':'Neşe Alkaya – Blog & Yazılar',url:canonical,inLanguage:isDe?'de-DE':'tr-TR',publisher:{'@id':personId}}]:[]),
 ...(article?[{'@type':'BlogPosting','@id':canonical+'#article',headline:article.title,description:article.excerpt,inLanguage:isDe?'de-DE':'tr-TR',datePublished:article.date,dateModified:article.date,mainEntityOfPage:{'@id':canonical+'#webpage'},author:{'@id':personId},publisher:{'@id':personId},articleSection:article.category,wordCount:article.wordCount||[article.intro,...article.sections.flatMap(s=>s.paragraphs)].join(' ').split(/\s+/u).length,about:article.category,isAccessibleForFree:true,url:canonical}]:[])
];
---
<!doctype html>
<html lang={isDe?'de':'tr'}>
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#692F34">
<meta name="description" content={description}>
<title>{displayTitle}</title>
<link rel="canonical" href={canonical}>
<link rel="alternate" hreflang="tr-TR" href={urlTR}>
<link rel="alternate" hreflang="de-DE" href={urlDE}>
<link rel="alternate" hreflang="x-default" href={urlTR}>
<meta property="og:type" content={article?'article':'website'}><meta property="og:locale" content={isDe?'de_DE':'tr_TR'}>
<meta property="og:locale:alternate" content={isDe?'tr_TR':'de_DE'}>
<meta property="og:site_name" content={site.name}>
{article&&<meta property="article:published_time" content={article.date}/>} 
<meta property="og:title" content={displayTitle}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={new URL('/nese-alkaya-portrait-2x.webp',site.url).href}>
<meta property="og:image:alt" content={isDe?'Porträt von Neşe Alkaya':'Neşe Alkaya portresi'}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={displayTitle}><meta name="twitter:description" content={description}>
<meta name="twitter:image" content={new URL('/nese-alkaya-portrait-2x.webp',site.url).href}>
<meta name="robots" content="index,follow,max-image-preview:large">
<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':graph})}/>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>
<body>
<a class="skip-link" href="#main">{isDe?'Zum Inhalt springen':'İçeriğe geç'}</a>
<header class="site-header"><div class="shell nav-wrap">
<a href={isDe?'/de/':'/'} class="brand" aria-label={isDe?'Neşe Alkaya Startseite':'Neşe Alkaya ana sayfa'}>NEŞE <span>ALKAYA</span><small>{isDe?'Achtsamkeit · Begleitung · Wandel':'Farkındalık · Rehberlik · Dönüşüm'}</small></a>
<nav aria-label={isDe?'Hauptmenü':'Ana menü'} id="main-nav">
{nav.map(n=><a href={n.href} aria-current={path===n.href || (n.href.endsWith('/angebote/')||n.href.endsWith('/hizmetler/'))&&path.startsWith(n.href)?'page':undefined}>{n.title}</a>)}
</nav>
<div class="lang-switch" role="group" aria-label={isDe?'Sprache wählen':'Dil seçimi'}>
<a href={urlTR.replace(site.url,'')} hreflang="tr" lang="tr" aria-current={!isDe?'page':undefined}>TR</a>
<span aria-hidden="true">/</span>
<a href={urlDE.replace(site.url,'')} hreflang="de" lang="de" aria-current={isDe?'page':undefined}>DE</a>
</div>
<a class="nav-action" href={wa} target="_blank" rel="noopener noreferrer">{isDe?'Gespräch anfragen':'Görüşme Planla'} <span aria-hidden="true">↗</span></a>
<button class="menu-toggle" type="button" aria-controls="main-nav" aria-expanded="false" aria-label={isDe?'Menü öffnen':'Menüyü aç'}>☰</button>
</div></header>
<main id="main"><slot /></main>
<footer class="site-footer"><div class="shell">
<div class="footer-grid">
<div><a href={isDe?'/de/':'/'} class="footer-brand">NEŞE ALKAYA</a><p>{isDe?'Ein ruhiger Raum, um neue Perspektiven auf den eigenen Weg zu gewinnen.':'Bir adım geri çekilip kendi yolunuza daha yakından bakabileceğiniz bir alan.'}</p></div>
<div><h3>{isDe?'Entdecken':'Keşfedin'}</h3>{nav.slice(1).map(n=><a href={n.href}>{n.title}</a>)}</div>
<div><h3>{isDe?'Soziale Medien':'Sosyal Medya'}</h3><SocialLinks label={isDe?'Soziale Medien':'Sosyal medya hesapları'}/></div>
<div><h3>{isDe?'Kontakt':'İletişim'}</h3><a href={'tel:+'+site.phone}>{site.phoneDisplay}</a><a href={'mailto:'+site.email}>{site.email}</a><a href={wa} target="_blank" rel="noopener noreferrer">WhatsApp ↗</a></div>
</div>
<div class="footer-bottom"><span>© {new Date().getFullYear()} Neşe Alkaya. {isDe?'Alle Rechte vorbehalten.':'Tüm hakları saklıdır.'}</span><span>{isDe?'Die Gespräche ersetzen keine medizinische, psychotherapeutische, rechtliche oder finanzielle Beratung.':'Görüşmeler tıbbi, psikolojik, hukuki veya finansal danışmanlık yerine geçmez.'}</span></div>
<div class="site-credit"><span>{isDe?'Mit Feingefühl gestaltet. Mit Präzision umgesetzt.':'Zarafet düşüncede başlar, ayrıntıda hayat bulur.'}</span><span>{isDe?'Digitale Umsetzung:':'Dijital tasarım ve geliştirme:'}</span> <a href="https://qctcommerce.com/" target="_blank" rel="noopener noreferrer" aria-label="QCT Commerce">QCT Commerce <span aria-hidden="true">↗</span></a></div>
</div></footer>
<div class="scroll-controls">
 <a class="scroll-control scroll-whatsapp" href={wa} target="_blank" rel="noopener noreferrer" aria-label={isDe?'Neşe Alkaya über WhatsApp kontaktieren':'Neşe Alkaya ile WhatsApp üzerinden iletişime geç'} title="WhatsApp">
  <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path fill="currentColor" d="M16.04 2.67A13.28 13.28 0 0 0 4.55 22.6L2.7 29.3l6.88-1.8A13.3 13.3 0 1 0 16.04 2.67Zm0 24.12c-2.12 0-4.18-.62-5.96-1.79l-.43-.26-4.09 1.07 1.1-3.99-.29-.45a10.82 10.82 0 1 1 9.67 5.42Zm5.94-8.08c-.33-.16-1.94-.96-2.24-1.07-.3-.11-.52-.16-.74.16-.22.33-.85 1.07-1.05 1.28-.19.22-.39.25-.71.09-.33-.16-1.38-.51-2.63-1.63-.97-.87-1.62-1.93-1.81-2.25-.19-.33-.02-.5.14-.66.15-.15.33-.39.49-.58.16-.19.22-.33.33-.55.11-.22.06-.41-.03-.58-.08-.16-.74-1.79-1.02-2.45-.27-.63-.54-.55-.74-.56h-.63c-.22 0-.58.08-.88.41-.3.33-1.16 1.13-1.16 2.76s1.19 3.2 1.35 3.42c.16.22 2.34 3.57 5.67 5 .79.34 1.41.54 1.89.69.79.25 1.51.21 2.08.13.63-.09 1.94-.79 2.21-1.55.27-.76.27-1.41.19-1.55-.08-.14-.3-.22-.63-.38Z"/></svg>
 </a>
 <button class="scroll-control scroll-top" type="button" aria-label={isDe?'Zurück nach oben':'Sayfanın en üstüne çık'} title={isDe?'Nach oben':'Yukarı çık'}>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 19V5m-7 7 7-7 7 7"/></svg>
 </button>
</div>
<script>
const btn=document.querySelector('.menu-toggle');const nav=document.querySelector('#main-nav');
btn?.addEventListener('click',()=>{const open=btn.getAttribute('aria-expanded')==='true';btn.setAttribute('aria-expanded',String(!open));btn.setAttribute('aria-label',open?(document.documentElement.lang==='de'?'Menü öffnen':'Menüyü aç'):(document.documentElement.lang==='de'?'Menü schließen':'Menüyü kapat'));nav?.classList.toggle('open',!open)});
nav?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{nav?.classList.remove('open');btn?.setAttribute('aria-expanded','false')}));
if('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches){
 const blocks=document.querySelectorAll('.section-heading,.page-hero .shell,.inner-hero .shell,.detail-hero .detail-content-wrap,.editorial-card,.spiritual-card,.service-catalog-item,.topic-columns article,.contact-page-grid,.social-feature-section .editorial-text-grid,.about-feature,.about-lead-grid');
 const observer=new IntersectionObserver((entries)=>{for(const entry of entries){if(entry.isIntersecting){entry.target.classList.add('is-in-view');observer.unobserve(entry.target)}}},{threshold:.08,rootMargin:'0px 0px -20px 0px'});
 blocks.forEach(el=>{el.classList.add('reveal-on-scroll');observer.observe(el)});
 document.body.classList.add('motion-ready');
}

// Floating actions are visible only while the visitor is actively scrolling.
const scrollControls=document.querySelector('.scroll-controls');
const backToTop=document.querySelector('.scroll-top');
let scrollHideTimer=0;
let lastScrollY=window.scrollY;
const hideControls=()=>scrollControls?.classList.remove('is-active');
const onPageScroll=()=>{
 const y=window.scrollY;
 if(Math.abs(y-lastScrollY)<2)return;
 lastScrollY=y;
 scrollControls?.classList.toggle('is-active',y>90);
 window.clearTimeout(scrollHideTimer);
 scrollHideTimer=window.setTimeout(hideControls,1300);
};
window.addEventListener('scroll',onPageScroll,{passive:true});
window.addEventListener('pagehide',()=>window.clearTimeout(scrollHideTimer),{once:true});
document.addEventListener('visibilitychange',()=>{if(document.hidden)hideControls()});
backToTop?.addEventListener('click',()=>{
 window.scrollTo({top:0,behavior:window.matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});
 hideControls();
});
</script>
</body></html>