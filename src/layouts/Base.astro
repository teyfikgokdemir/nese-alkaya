---
import {site} from '../data/content.js';
import '../styles/global.css';
const {title=site.name,description=site.description,path=Astro.url.pathname,crumbs=[]}=Astro.props;
const canonical=new URL(path,site.url).href;
const wa='https://wa.me/'+site.phone+'?text='+encodeURIComponent('Merhaba Neşe Hanım, web siteniz üzerinden görüşme hakkında bilgi almak istiyorum.');
const graph=[
 {'@type':'Person','@id':site.url+'/#person',name:site.name,url:site.url,description:site.description,sameAs:site.socials.map(s=>s.href)},
 {'@type':'WebSite','@id':site.url+'/#website',url:site.url,name:site.name,inLanguage:'tr-TR',publisher:{'@id':site.url+'/#person'}},
 {'@type':'WebPage',url:canonical,name:title,description,inLanguage:'tr-TR',isPartOf:{'@id':site.url+'/#website'},...(crumbs.length?{breadcrumb:{'@type':'BreadcrumbList',itemListElement:crumbs.map((c,i)=>({'@type':'ListItem',position:i+1,name:c.name,item:new URL(c.href,site.url).href}))}}:{})}
];
---
<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#193e35"><meta name="description" content={description}>
<title>{title} | Neşe Alkaya</title><link rel="canonical" href={canonical}>
<meta property="og:type" content="website"><meta property="og:locale" content="tr_TR"><meta property="og:title" content={title+' | Neşe Alkaya'}><meta property="og:description" content={description}><meta property="og:url" content={canonical}>
<meta name="twitter:card" content="summary"><meta name="robots" content="index,follow,max-image-preview:large">
<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':graph})}/>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>
<body>
<a class="skip-link" href="#main">İçeriğe geç</a>
<header class="site-header"><div class="shell nav-wrap">
<a href="/" class="brand" aria-label="Neşe Alkaya ana sayfa">NEŞE <span>ALKAYA</span><small>Farkındalık · Rehberlik · Dönüşüm</small></a>
<nav aria-label="Ana menü" id="main-nav"><a href="/">Ana Sayfa</a><a href="/hakkimda/">Hakkımda</a><a href="/hizmetler/">Hizmetler</a><a href="/icerikler/">İçerikler</a><a href="/iletisim/">İletişim</a></nav>
<a class="nav-action" href={wa} target="_blank" rel="noopener noreferrer">Görüşme Planla <span aria-hidden="true">↗</span></a>
<button class="menu-toggle" type="button" aria-controls="main-nav" aria-expanded="false" aria-label="Menüyü aç">☰</button>
</div></header>
<main id="main"><slot /></main>
<section class="contact-ribbon" aria-label="Hızlı iletişim">
  <div class="shell contact-ribbon-inner">
    <div class="contact-ribbon-item"><span>WhatsApp</span><a href={wa} target="_blank" rel="noopener noreferrer">{site.phoneDisplay} <span aria-hidden="true">↗</span></a></div>
    <div class="contact-ribbon-item"><span>E-posta</span><a href={'mailto:'+site.email}>{site.email} <span aria-hidden="true">↗</span></a></div>
    <div class="contact-ribbon-item contact-ribbon-social"><span>Sosyal medya</span><div>{site.socials.map(s=><a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}>{s.label} ↗</a>)}</div></div>
  </div>
</section>
<footer class="site-footer"><div class="shell">
<div class="footer-grid"><div><a href="/" class="footer-brand">NEŞE ALKAYA</a><p>Bir adım geri çekilip kendi yolunuza daha yakından bakabileceğiniz bir alan.</p></div>
<div><h3>Keşfedin</h3><a href="/hakkimda/">Neşe Hakkında</a><a href="/hizmetler/">Hizmetler</a><a href="/icerikler/">İçerikler</a><a href="/iletisim/">İletişim</a></div>
<div><h3>Sosyal Medya</h3>{site.socials.map(s=><a href={s.href} target="_blank" rel="noopener noreferrer">{s.label} ↗</a>)}</div>
<div><h3>İletişim</h3><a href={'tel:+'+site.phone}>{site.phoneDisplay}</a><a href={'mailto:'+site.email}>{site.email}</a><a href={wa} target="_blank" rel="noopener noreferrer">WhatsApp ↗</a></div></div>
<div class="footer-bottom"><span>© {new Date().getFullYear()} Neşe Alkaya. Tüm hakları saklıdır.</span><span>Görüşmeler tıbbi, psikolojik, hukuki veya finansal danışmanlık yerine geçmez.</span></div>
</div></footer>
<script>
const btn=document.querySelector('.menu-toggle');const nav=document.querySelector('#main-nav');
btn?.addEventListener('click',()=>{const open=btn.getAttribute('aria-expanded')==='true';btn.setAttribute('aria-expanded',String(!open));btn.setAttribute('aria-label',open?'Menüyü aç':'Menüyü kapat');nav?.classList.toggle('open',!open);});
nav?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{nav?.classList.remove('open');btn?.setAttribute('aria-expanded','false')}));
</script>
</body></html>