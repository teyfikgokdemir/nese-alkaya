---
import {site} from '../data/content.js';
import {dePathMap,trPathMap,deSiteDescription,deServices} from '../data/de.js';
import '../styles/global.css';
import SocialLinks from '../components/SocialLinks.astro';
const {title=site.name,description=site.description,path=Astro.url.pathname,crumbs=[],lang='tr',service=null,faqItems=[]}=Astro.props;
const isDe=lang==='de';
const canonical=new URL(path,site.url).href;
const localPath=isDe?(trPathMap[path]||'/'):(dePathMap[path]||'/de/');
const alternate=new URL(localPath,site.url).href;
const urlTR=isDe?alternate:canonical;
const urlDE=isDe?canonical:alternate;
const wa='https://wa.me/'+site.phone+'?text='+encodeURIComponent(isDe?'Guten Tag Frau Alkaya, ich möchte mich über ein Gespräch informieren.':'Merhaba Neşe Hanım, web siteniz üzerinden görüşme hakkında bilgi almak istiyorum.');
const nav=isDe?[
 {title:'Startseite',href:'/de/'},{title:'Über mich',href:'/de/ueber-mich/'},{title:'Angebote',href:'/de/angebote/'},{title:'Einblicke',href:'/de/einblicke/'},{title:'Kontakt',href:'/de/kontakt/'}
]:[
 {title:'Ana Sayfa',href:'/'},{title:'Hakkımda',href:'/hakkimda/'},{title:'Hizmetler',href:'/hizmetler/'},{title:'İçerikler',href:'/icerikler/'},{title:'İletişim',href:'/iletisim/'}
];
const displayTitle=title===site.name?site.name:title+' | '+site.name;
const personId=site.url+'/#person';
const websiteId=site.url+'/#website';
const graph=[
 {'@type':'Person','@id':personId,name:site.name,url:site.url,description:site.description,image:new URL('/nese-alkaya-portrait-2x.webp',site.url).href,sameAs:site.socials.map(s=>s.href),knowsAbout:['Persönliches Coaching','Yaşam koçluğu','Manevi rehberlik','Spirituelle Begleitung']},
 {'@type':'WebSite','@id':websiteId,url:site.url,name:site.name,inLanguage:['tr-TR','de-DE'],publisher:{'@id':personId}},
 {'@type':'WebPage','@id':canonical+'#webpage',url:canonical,name:title,description,inLanguage:isDe?'de-DE':'tr-TR',isPartOf:{'@id':websiteId},about:{'@id':personId},primaryImageOfPage:{'@type':'ImageObject',url:new URL('/nese-alkaya-portrait-2x.webp',site.url).href},...(crumbs.length?{breadcrumb:{'@type':'BreadcrumbList',itemListElement:crumbs.map((c,i)=>({'@type':'ListItem',position:i+1,name:c.name,item:new URL(c.href,site.url).href}))}}:{})},
 ...(service?[{'@type':'Service',name:service.title,description:service.short,provider:{'@id':personId},url:canonical,serviceType:isDe?'Persönliches Gespräch':'Bireysel görüşme'}]:[]),
 ...(faqItems.length?[{'@type':'FAQPage',mainEntity:faqItems.map(item=>({'@type':'Question',name:item.q,acceptedAnswer:{'@type':'Answer',text:item.a}}))}]:[])
];
---
<!doctype html>
<html lang={isDe?'de':'tr'}>
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#692F34">
<meta name="description" content={description}>
<title>{displayTitle}</title>
<link rel="canonical" href={canonical}>
<link rel="alternate" hreflang="tr-TR" href={urlTR}>
<link rel="alternate" hreflang="de-DE" href={urlDE}>
<link rel="alternate" hreflang="x-default" href={urlTR}>
<meta property="og:type" content="website"><meta property="og:locale" content={isDe?'de_DE':'tr_TR'}>
<meta property="og:locale:alternate" content={isDe?'tr_TR':'de_DE'}>
<meta property="og:site_name" content={site.name}>
<meta property="og:title" content={displayTitle}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={new URL('/nese-alkaya-portrait-2x.webp',site.url).href}>
<meta property="og:image:alt" content={isDe?'Porträt von Neşe Alkaya':'Neşe Alkaya portresi'}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={displayTitle}><meta name="twitter:description" content={description}>
<meta name="twitter:image" content={new URL('/nese-alkaya-portrait-2x.webp',site.url).href}>
<meta name="robots" content="index,follow,max-image-preview:large">
<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':graph})}/>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>
<body>
<a class="skip-link" href="#main">{isDe?'Zum Inhalt springen':'İçeriğe geç'}</a>
<header class="site-header"><div class="shell nav-wrap">
<a href={isDe?'/de/':'/'} class="brand" aria-label={isDe?'Neşe Alkaya Startseite':'Neşe Alkaya ana sayfa'}>NEŞE <span>ALKAYA</span><small>{isDe?'Achtsamkeit · Begleitung · Wandel':'Farkındalık · Rehberlik · Dönüşüm'}</small></a>
<nav aria-label={isDe?'Hauptmenü':'Ana menü'} id="main-nav">
{nav.map(n=><a href={n.href} aria-current={path===n.href || (n.href.endsWith('/angebote/')||n.href.endsWith('/hizmetler/'))&&path.startsWith(n.href)?'page':undefined}>{n.title}</a>)}
</nav>
<div class="lang-switch" role="group" aria-label={isDe?'Sprache wählen':'Dil seçimi'}>
<a href={urlTR.replace(site.url,'')} hreflang="tr" lang="tr" aria-current={!isDe?'page':undefined}>TR</a>
<span aria-hidden="true">/</span>
<a href={urlDE.replace(site.url,'')} hreflang="de" lang="de" aria-current={isDe?'page':undefined}>DE</a>
</div>
<a class="nav-action" href={wa} target="_blank" rel="noopener noreferrer">{isDe?'Gespräch anfragen':'Görüşme Planla'} <span aria-hidden="true">↗</span></a>
<button class="menu-toggle" type="button" aria-controls="main-nav" aria-expanded="false" aria-label={isDe?'Menü öffnen':'Menüyü aç'}>☰</button>
</div></header>
<main id="main"><slot /></main>
<footer class="site-footer"><div class="shell">
<div class="footer-grid">
<div><a href={isDe?'/de/':'/'} class="footer-brand">NEŞE ALKAYA</a><p>{isDe?'Ein ruhiger Raum, um neue Perspektiven auf den eigenen Weg zu gewinnen.':'Bir adım geri çekilip kendi yolunuza daha yakından bakabileceğiniz bir alan.'}</p></div>
<div><h3>{isDe?'Entdecken':'Keşfedin'}</h3>{nav.slice(1).map(n=><a href={n.href}>{n.title}</a>)}</div>
<div><h3>{isDe?'Soziale Medien':'Sosyal Medya'}</h3><SocialLinks label={isDe?'Soziale Medien':'Sosyal medya hesapları'}/></div>
<div><h3>{isDe?'Kontakt':'İletişim'}</h3><a href={'tel:+'+site.phone}>{site.phoneDisplay}</a><a href={'mailto:'+site.email}>{site.email}</a><a href={wa} target="_blank" rel="noopener noreferrer">WhatsApp ↗</a></div>
</div>
<div class="footer-bottom"><span>© {new Date().getFullYear()} Neşe Alkaya. {isDe?'Alle Rechte vorbehalten.':'Tüm hakları saklıdır.'}</span><span>{isDe?'Die Gespräche ersetzen keine medizinische, psychotherapeutische, rechtliche oder finanzielle Beratung.':'Görüşmeler tıbbi, psikolojik, hukuki veya finansal danışmanlık yerine geçmez.'}</span></div>
</div></footer>
<script>
const btn=document.querySelector('.menu-toggle');const nav=document.querySelector('#main-nav');
btn?.addEventListener('click',()=>{const open=btn.getAttribute('aria-expanded')==='true';btn.setAttribute('aria-expanded',String(!open));btn.setAttribute('aria-label',open?(document.documentElement.lang==='de'?'Menü öffnen':'Menüyü aç'):(document.documentElement.lang==='de'?'Menü schließen':'Menüyü kapat'));nav?.classList.toggle('open',!open)});
nav?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{nav?.classList.remove('open');btn?.setAttribute('aria-expanded','false')}));
</script>
</body></html>