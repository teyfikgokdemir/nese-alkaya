---
import Base from '../layouts/Base.astro';
import {coaching,spiritual,journey,topics,site} from '../data/content.js';
const wa='https://wa.me/'+site.phone+'?text='+encodeURIComponent('Merhaba Neşe Hanım, görüşme planlamak istiyorum.');
---
<Base title="Kendine Doğru Bir Yolculuk" description="Neşe Alkaya ile yaşam koçluğu, manevi rehberlik ve farkındalık üzerine bireysel görüşmeler. Hizmetleri keşfedin ve iletişime geçin.">
<section class="hero"><div class="shell hero-grid"><div class="hero-copy"><span class="eyebrow">Farkındalık · Rehberlik · Dönüşüm</span><h1>Kendine doğru bir yolculuk.</h1><p>Bazen ihtiyacımız olan şey yeni bir yol değil; kendi yolumuzu daha net görebilmektir.</p><div class="hero-actions"><a class="btn" href={wa} target="_blank" rel="noopener noreferrer">Görüşme Planla ↗</a><a class="btn on-dark" href="/hakkimda/">Yaklaşımımı Keşfet</a></div></div><div class="hero-visual" role="img" aria-label="Orman yeşili ve sıcak kum tonlarında soyut Neşe Alkaya marka illüstrasyonu"><div class="visual-top">Neşe Alkaya · Kişisel Rehberlik</div><div class="visual-bottom">Her yolculuk bir fark edişle başlar.</div></div></div></section>
<section class="section"><div class="shell split"><div class="quote-panel"><span>Birlikte yeniden bakmak</span><blockquote>“Bazen bir söz, yeni bir yolun başlangıcıdır.”</blockquote><span>Farkındalık • İçgörü • Yön</span></div><div><span class="eyebrow">Bireysel yol arkadaşlığı</span><h2 class="section-title">Kendi cevaplarınıza yaklaşın.</h2><p class="lead">Neşe Alkaya; düşünceleri toparlamak, duyguları anlamlandırmak ve kararları daha net bir yerden ele almak isteyen insanlara saygı ve yapı temelli bir eşlik alanı sunar.</p><p>Yaşam koçluğuna dayanan iletişim araçları ile Alevilik yolunda taşıdığı manevi birikim, yaklaşımının farklı ama birbirine saygılı iki boyutunu oluşturur.</p><a class="btn secondary" href="/hakkimda/">Neşe'yi Tanıyın ↗</a></div></div></section>
<section class="section" style="background:#ede9df"><div class="shell"><span class="eyebrow">01 / Yaşam Koçluğu</span><h2 class="section-title">Hayatın dönüm noktalarında daha net bir bakış.</h2><p class="lead">Kararlar, ilişkiler, yön arayışı ve yeni başlangıçlar üzerine bireysel görüşmeler.</p><div class="card-grid">{coaching.map((s,i)=><a class="service-card" href={'/hizmetler/'+s.slug+'/'}><span class="card-tag">Yaşam Koçluğu / 0{i+1}</span><h3>{s.title}</h3><p>{s.short}</p><span class="card-link">Detayları keşfet ↗</span></a>)}</div></div></section>
<section class="section dark"><div class="shell"><span class="eyebrow">02 / Manevi Rehberlik</span><h2 class="section-title">Geleneğin ve sezgilerin dili.</h2><p class="lead">Duru görü, rüya yorumlama, tuz bakımı ve diğer geleneksel uygulamalara yönelik manevi yorum ve görüşmeler. Bu çalışmalar bilimsel teşhis veya kesin öngörü olarak sunulmaz.</p><div class="card-grid">{spiritual.map(s=><a class="service-card" href={'/hizmetler/'+s.slug+'/'}><span class="card-tag">Manevi rehberlik</span><h3>{s.title}</h3><p>{s.short}</p><span class="card-link">Detayları keşfet ↗</span></a>)}</div></div></section>
<section class="section"><div class="shell split"><div><span class="eyebrow">Neşe Hakkında</span><h2 class="section-title">Bilgi, deneyim ve manevi sorumluluk.</h2><p class="lead">Türkiye ve farklı ülkelerde danışanlarıyla çalıştığını belirten Neşe Alkaya, NLP temelli iletişim araçlarıyla geliştirdiği koçluk yaklaşımını Alevilik yolundaki manevi birikiminden ayrı bir sorumluluk alanı olarak görür.</p><p>İNİLPTA değil, INLPTA – Certified Practitioner unvanı, kendisinin paylaştığı mesleki bilgiler arasında yer almaktadır. Belge ayrıntıları ayrıca teyit edilecektir.</p><a class="btn secondary" href="/hakkimda/">Hikâyeyi okuyun ↗</a></div><div class="quote-panel"><span>Yaklaşımın özü</span><blockquote>“İnsanı kim olduğuna göre değil, yaratandan ötürü seven bir duruş.”</blockquote><span>Saygı · Eşitlik · Manevi sorumluluk</span></div></div></section>
<section class="section" style="background:#eae6dc"><div class="shell"><span class="eyebrow">Sosyal medya gündemi</span><h2 class="section-title">Hayatın içinden konuşmalar.</h2><p class="lead">Neşe Alkaya’nın sosyal medya paylaşımlarında ele aldığı kararlar, ilişkiler, umut ve içsel farkındalık konularından seçkiler.</p><div class="content-teaser">{topics.map(t=><article class="teaser"><h3>{t.title}</h3><p>{t.text}</p></article>)}</div><a href="/icerikler/" class="btn secondary">İçerikleri Keşfet ↗</a></div></section>
<section class="section dark"><div class="shell"><span class="eyebrow">Bir görüşmeye giden yol</span><h2 class="section-title">Üç sade adım.</h2><div class="steps">{journey.map(x=><div class="step"><span>{x.number}</span><h3>{x.title}</h3><p>{x.text}</p></div>)}</div></div></section>
<section class="section"><div class="shell cta-block"><div><span class="eyebrow">Bir görüşme ile başlayabilirsiniz</span><h2 class="section-title">Kendi yolunuza daha net bakmak için.</h2><p>Görüşme biçimi, uygunluk ve kapsam hakkında bilgi almak için doğrudan iletişime geçin.</p></div><a class="btn" href={wa} target="_blank" rel="noopener noreferrer">WhatsApp ile İletişim ↗</a></div></section>
</Base>