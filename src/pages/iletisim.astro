---
import Base from '../layouts/Base.astro';
import {site} from '../data/content.js';
const wa='https://wa.me/'+site.phone+'?text='+encodeURIComponent('Merhaba Neşe Hanım, web siteniz üzerinden görüşme hakkında bilgi almak istiyorum.');
---
<Base title="İletişim & Görüşme" description="Neşe Alkaya ile WhatsApp ve e-posta üzerinden iletişime geçin, görüşme seçeneklerini öğrenin.">
<section class="page-hero"><div class="shell"><span class="overline">İletişim</span><h1>Bir görüşme ile başlayabilirsiniz.</h1><p class="lead">Hangi konuda görüşmek istediğinizi paylaşın; uygunluk, süre ve görüşme biçimini birlikte netleştirin.</p></div></section>
<section class="section section-warm"><div class="shell contact-page-grid">
<div class="contact-page-primary"><span class="overline">Doğrudan iletişim</span><h2>Size uygun bir başlangıç.</h2><p>Görüşme talebinizi en kolay WhatsApp üzerinden iletebilirsiniz.</p><a class="button button-gold" href={wa} target="_blank" rel="noopener noreferrer">WhatsApp ile görüşün <span aria-hidden="true">↗</span></a></div>
<div class="contact-page-secondary"><span class="overline">İletişim bilgileri</span><a href={'tel:+'+site.phone}>{site.phoneDisplay}</a><a href={'mailto:'+site.email}>{site.email}</a><div class="social-list">{site.socials.map(s=><a href={s.href} target="_blank" rel="noopener noreferrer">{s.label} ↗</a>)}</div></div>
</div></section>
</Base>