---
import Base from '../../layouts/Base.astro';
import ServiceDetail from '../../components/ServiceDetail.astro';
import {services,coaching} from '../../data/content.js';
import {expandedServiceCopy} from '../../data/service-expanded.js';
export function getStaticPaths(){return services.map(service=>({params:{slug:service.slug},props:{service}}));}
const {service}=Astro.props;
const isCoaching=coaching.some(s=>s.slug===service.slug);
const faqItems=expandedServiceCopy[service.slug].tr.faq;
---
<Base service={service} faqItems={faqItems} title={service.title} description={service.short} crumbs={[{name:'Ana Sayfa',href:'/'},{name:'Hizmetler',href:'/hizmetler/'},{name:service.title,href:Astro.url.pathname}]}>
  <ServiceDetail service={service} lang="tr" isCoaching={isCoaching} />
</Base>
